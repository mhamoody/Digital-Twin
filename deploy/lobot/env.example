# Copy to the repository root as .env.lobot. This file-backed database is for
# the small JupyterHub interface pilot only; the always-on deployment uses PostgreSQL.
DIGITAL_TWIN_DATABASE_URL='sqlite+pysqlite:///var/data/digital_twin.sqlite3'
DIGITAL_TWIN_AUTH_FILE='var/auth/instructors.json'
DIGITAL_TWIN_PRESENTATION_ID='oulad:AAA:2013J'

# Replace the SQLite URL with this only when an approved PostgreSQL host exists:
# DIGITAL_TWIN_DATABASE_URL='postgresql+psycopg://APP_USER:APP_PASSWORD@DB_HOST:5432/course_digital_twin'

# Needed only when testing the signed Moodle harness. Future onQ uses LTI 1.3 instead.
# DIGITAL_TWIN_LMS_SHARED_SECRET='REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES'
