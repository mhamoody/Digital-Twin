# Copy to .env and replace every placeholder locally. Never commit the real file.
DIGITAL_TWIN_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost/course_digital_twin

# Set for a protected standalone pilot. Generate the ignored file with
# scripts/manage_instructor_accounts.py; do not hand-write password hashes.
DIGITAL_TWIN_AUTH_FILE=var/auth/instructors.json
DIGITAL_TWIN_PRESENTATION_ID=moodle-replay:AAA:2030A

# Local Moodle plugin request signing. Use a random value of at least 32 bytes.
# Queen's onQ will use LTI 1.3 keys instead of this shared-secret profile.
DIGITAL_TWIN_LMS_SHARED_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET

# Optional live local Moodle reader. HTTP is accepted only for loopback Laragon.
MOODLE_BASE_URL=http://127.0.0.1/moodle
MOODLE_TOKEN=REPLACE_WITH_READ_ONLY_WEB_SERVICE_TOKEN
MOODLE_COURSE_ID=REPLACE_WITH_NUMERIC_TEST_COURSE_ID
